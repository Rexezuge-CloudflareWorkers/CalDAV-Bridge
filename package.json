{
  "name": "@caldav-bridge/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-spa-shell-stub.mjs && pnpm run typegen",
    "build": "pnpm -r build",
    "check:god-files": "node scripts/check-god-files.mjs",
    "checks": "pnpm -r typecheck && pnpm run typecheck:test && pnpm run lint && pnpm run test && pnpm run check:god-files",
    "checks:all": "pnpm run checks && pnpm run test:integration",
    "prettier": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config test/integration/vitest.config.mts",
    "lint": "eslint --ext .ts,.tsx --fix .",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.x",
    "@types/react": "^19.3.x",
    "@types/react-dom": "^19.3.x",
    "@vitejs/plugin-react": "^6.1.x",
    "@vitest/coverage-v8": "^4.1.x",
    "eslint": "^10.11.x",
    "eslint-config-prettier": "^10.1.x",
    "eslint-plugin-prettier": "^5.5.x",
    "eslint-plugin-react-hooks": "^7.1.x",
    "globals": "^17.12.x",
    "happy-dom": "^20.14.5",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.x",
    "tailwindcss": "^4.3.x",
    "terser": "^5.51.x",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.x",
    "vite": "^8.3.x",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.1"
  },
  "packageManager": "pnpm@11.2.2"
}
