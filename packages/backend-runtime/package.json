{
  "name": "@caldav-bridge/backend-runtime",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base/index.ts",
    "./base/*": "./src/base/*.ts",
    "./config": "./src/config/index.ts",
    "./config/*": "./src/config/*.ts",
    "./constants": "./src/constants/index.ts",
    "./constants/*": "./src/constants/*.ts",
    "./http": "./src/http/index.ts",
    "./http/*": "./src/http/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@caldav-bridge/backend-errors": "workspace:*",
    "@caldav-bridge/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.4.x",
    "typescript": "^6.0.3"
  }
}
